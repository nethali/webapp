# Start from a standard Ubuntu 24.04 base image
FROM ubuntu:24.04

# Attach metadata labels to identify the author, description, and variant/version
LABEL author="Nethali Zoysa"
LABEL description="Simple Web App in Node.js"
LABEL version="ubuntu"

# Avoid interactive prompts during apt package installations
ENV DEBIAN_FRONTEND=noninteractive

# Update apt package lists, install Node.js and npm without optional recommended packages,
# and remove cached apt package lists in the same layer to keep the image smaller
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# Create a dedicated system group (nodegroup) and non-root user (nodeuser) with a home directory
RUN groupadd --system nodegroup && useradd --system --gid nodegroup --create-home nodeuser

# Set /app as the working directory inside the container for all subsequent instructions
WORKDIR /app

# Assign ownership of /app recursively to nodeuser:nodegroup before installing or copying files
RUN chown -R nodeuser:nodegroup /app

# Switch from root to the non-root nodeuser for dependency installation and running the app
USER nodeuser

# Copy package manifests (package.json and package-lock.json if present) first so Docker
# can reuse the cached dependency layer when only application source files change
COPY --chown=nodeuser:nodegroup package*.json ./

# Perform a clean install of production-only dependencies (excluding devDependencies)
# using the exact versions locked in package-lock.json
RUN npm ci --omit=dev

# Copy the remaining application source code (respecting .dockerignore) into /app
# with ownership set to nodeuser:nodegroup
COPY --chown=nodeuser:nodegroup . .

# Document that the Express application inside the container listens on port 8080
EXPOSE 8080

# Launch the Node.js web server when the container starts
CMD ["node", "app.js"]